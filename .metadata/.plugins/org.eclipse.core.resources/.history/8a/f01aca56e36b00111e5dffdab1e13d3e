/**
 * @file  fault_hard_fault.c
 * @brief NEXUS — Cortex-M HardFault fault injection
 *
 * Strategy:
 *   Phase 1 — Normal operation cycles.
 *   Phase 2 — Dereference a NULL function pointer, triggering a
 *             genuine Cortex-M HardFault exception.
 *   Phase 3 — HardFault_Handler (naked asm trampoline) extracts the
 *             stacked PC/LR plus CFSR/HFSR fault status registers
 *             and logs EVT_HARD_FAULT with the faulting PC as payload.
 *
 * Requirements:
 *   - This file's HardFault_Handler REPLACES the weak default one
 *     generated by CubeMX (in stm32f4xx_it.c). Remove or comment out
 *     that definition, or you'll get a duplicate symbol link error.
 *   - SCB->CCR FAULTMASK / usage-fault traps are not required; this
 *     relies on the bus fault generated by a true NULL deref.
 */

#include "fault_hard_fault.h"
#include "logger.h"

#include <stddef.h>
#include "FreeRTOS.h"
#include "task.h"
#include "stm32f4xx.h"

#define HF_NORMAL_CYCLES     20u
#define HF_PERIOD_MS         30u

/* -----------------------------------------------------------
 * Fault trigger — NULL function pointer call
 *
 * Volatile + function-pointer indirection prevents the compiler
 * from optimizing away or diagnosing the NULL deref at build time.
 * ----------------------------------------------------------*/

typedef void (*FaultFunc_t)(void);

void TriggerFault_HardFault(void)
{
    volatile FaultFunc_t bad_func = (FaultFunc_t)NULL;

    bad_func();   /* Branches to address 0x00000000 -> HardFault */
}

/* -----------------------------------------------------------
 * Fault injection task
 * ----------------------------------------------------------*/

void Task_FaultHardFault(void *pvParameters)
{
    (void)pvParameters;

    for (uint32_t i = 0u; i < HF_NORMAL_CYCLES; i++)
    {
        LOG_INFO(EVT_TASK_START, i);

        vTaskDelay(pdMS_TO_TICKS(HF_PERIOD_MS));

        LOG_INFO(EVT_TASK_END, i);
    }

    TriggerFault_HardFault();

    /* Never reached */
    for (;;)
    {
        __NOP();
    }
}

/* -----------------------------------------------------------
 * HardFault handler
 *
 * Extracts the stacked register frame to recover the faulting PC,
 * then logs CFSR (Configurable Fault Status Register) as payload —
 * encodes which sub-fault occurred (bus fault, usage fault, etc).
 * ----------------------------------------------------------*/

void HardFault_Handler(void)
{
    __asm volatile
    (
        "tst lr, #4              \n"
        "ite eq                  \n"
        "mrseq r0, msp           \n"
        "mrsne r0, psp           \n"
        "ldr r1, =HardFault_LogAndHalt \n"
        "bx r1                   \n"
    );
}

/* Called from the asm trampoline above with the stacked frame
 * pointer in r0. Frame layout: r0,r1,r2,r3,r12,LR,PC,xPSR */
void HardFault_LogAndHalt(uint32_t *stacked_frame)
{
    uint32_t faulting_pc = stacked_frame[6];
    uint32_t cfsr        = SCB->CFSR;

    (void)faulting_pc;

    /* Payload = CFSR; faulting PC is recoverable from this if you
     * also want to log it via a second EVT_USER_x entry. */
    LOG_FAULT(EVT_HARD_FAULT, cfsr);

    Logger_DumpUART();

    taskDISABLE_INTERRUPTS();

    for (;;)
    {
        __NOP();
    }
}
